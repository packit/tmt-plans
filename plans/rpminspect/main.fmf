summary: Run rpminspect on all rpms

provision:
  how: container
  image: fedora:latest

prepare:
  - how: artifact
    provide:
      - copr.repository:@rpmisnpect/latest
      - copr.repository:@osci/fedora-license-data
    verify: false
  - how: shell
    script: |
      echo "DIST_GIT_BRANCH=$@{dist-git-branch}" >> "$TMT_PLAN_ENVIRONMENT_FILE"

discover:
  how: fmf
  test: /tests/rpminspect
